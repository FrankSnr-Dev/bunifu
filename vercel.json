{
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": false,
  "functions": {
    "api/*.js": {
      "includeFiles": "api/_templates/**",
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/page?p=index"
    },
    {
      "source": "/about",
      "destination": "/api/page?p=about"
    },
    {
      "source": "/services",
      "destination": "/api/page?p=services"
    },
    {
      "source": "/how-we-work",
      "destination": "/api/page?p=how-we-work"
    },
    {
      "source": "/pricing",
      "destination": "/api/page?p=pricing"
    },
    {
      "source": "/blog",
      "destination": "/api/page?p=blog"
    },
    {
      "source": "/faq",
      "destination": "/api/page?p=faq"
    },
    {
      "source": "/contact",
      "destination": "/api/page?p=contact"
    },
    {
      "source": "/privacy",
      "destination": "/api/page?p=privacy"
    },
    {
      "source": "/services/:slug",
      "destination": "/api/page?p=:slug"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/page?p=post&slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/page?p=sitemap"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/about.html",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/services.html",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/how-we-work.html",
      "destination": "/how-we-work",
      "permanent": true
    },
    {
      "source": "/pricing.html",
      "destination": "/pricing",
      "permanent": true
    },
    {
      "source": "/blog.html",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/faq.html",
      "destination": "/faq",
      "permanent": true
    },
    {
      "source": "/contact.html",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/privacy.html",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/blog-social-media-mistakes.html",
      "destination": "/blog/social-media-mistakes",
      "permanent": true
    },
    {
      "source": "/blog-website-or-instagram.html",
      "destination": "/blog/website-or-instagram",
      "permanent": true
    },
    {
      "source": "/blog-whatsapp-business-sales.html",
      "destination": "/blog/whatsapp-business-sales",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
